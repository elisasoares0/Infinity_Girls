# Copie para api/.env (ou use o .env da raiz, o mesmo dos scripts da pasta db/)
SUPABASE_URL=sua_url_do_supabase_aqui
# Chave PÚBLICA (anon). Nunca coloque a service_role aqui.
SUPABASE_KEY=sua_chave_publica_aqui

# Endereços do front que podem chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://spaceapps2026-infinitygirls.web.app,https://spaceapps2026-infinitygirls.firebaseapp.com,https://spaceapps-infinitygirls.web.app,https://spaceapps-infinitygirls.firebaseapp.com
